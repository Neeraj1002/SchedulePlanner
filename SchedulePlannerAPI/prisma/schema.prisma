generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum ClassType {
  LECTURE
  TUTORIAL
  PRACTICAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SemesterType {
  AUTUMN
  SPRING
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
  EXTRA
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  BUNKED
}

//////////////////////
// CORE STRUCTURE
//////////////////////

model University {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  departments Department[]
}

model Department {
  id           Int        @id @default(autoincrement())
  name         String
  universityId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  semesters    Semester[]
  courses      Course[]
  batches      Batch[]
  offerings    CourseOffering[]

  @@unique([universityId, name])
}

model Semester {
  id             Int          @id @default(autoincrement())
  departmentId   Int
  semesterNumber Int          // 1,2,3,4...
  semesterType   SemesterType // AUTUMN / SPRING
  academicYear   String       // "2025-2026"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  batches        Batch[]
  classSessions  ClassSession[]
  imports        TimetableImport[]

  @@unique([departmentId, semesterNumber, academicYear])
}

//////////////////////
// COURSE LAYER
//////////////////////

model Course {
  id           Int      @id @default(autoincrement())
  courseCode   String
  courseName   String?
  departmentId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sessions     ClassSession[]
  offerings    CourseOffering[]

  @@unique([courseCode, departmentId])
  @@index([departmentId])
}

model CourseOffering {
  id           Int          @id @default(autoincrement())
  courseId     Int
  departmentId Int
  year         Int
  semesterType SemesterType
  createdAt    DateTime     @default(now())

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([courseId, departmentId, year, semesterType])
  @@index([departmentId, year, semesterType])
}

//////////////////////
// BATCH + USER
//////////////////////

model Batch {
  id           Int                 @id @default(autoincrement())
  batchCode    String
  departmentId Int
  semesterId   Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semester     Semester            @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  users        User[]
  sessions     ClassSessionBatch[]

  @@unique([batchCode, semesterId])
  @@index([semesterId])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  batchId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch       Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  attendances Attendance[]

  @@index([batchId])
}

//////////////////////
// TIMETABLE (TEMPLATE)
//////////////////////

model ClassSession {
  id         Int        @id @default(autoincrement())
  courseId   Int
  semesterId Int
  importId   Int?

  classType  ClassType
  dayOfWeek  DayOfWeek
  startTime  String
  endTime    String

  room       String?
  faculty    String?

  rawText    String?
  sourcePage Int?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  import     TimetableImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  batches     ClassSessionBatch[]
  occurrences ClassOccurrence[]

  @@unique([courseId, semesterId, dayOfWeek, startTime, classType])
  @@index([semesterId, dayOfWeek, startTime])
}

model ClassSessionBatch {
  id             Int          @id @default(autoincrement())
  classSessionId Int
  batchId        Int

  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, batchId])
  @@index([batchId])
}

//////////////////////
// REAL-WORLD LAYER
//////////////////////

model ClassOccurrence {
  id             Int              @id @default(autoincrement())
  classSessionId Int
  date           DateTime
  status         OccurrenceStatus @default(SCHEDULED)

  source         String?          // AUTO | MANUAL
  createdAt      DateTime         @default(now())

  classSession   ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  attendances    Attendance[]

  @@unique([classSessionId, date])
  @@index([date])
}

model Attendance {
  id           Int              @id @default(autoincrement())
  occurrenceId Int
  userId       Int
  status       AttendanceStatus
  markedAt     DateTime         @default(now())

  occurrence   ClassOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, userId])
  @@index([userId])
}

//////////////////////
// IMPORT TRACKING
//////////////////////

model TimetableImport {
  id         Int        @id @default(autoincrement())
  semesterId Int
  filename   String
  checksum   String
  importedAt DateTime   @default(now())
  parserWarnings Json?

  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sessions   ClassSession[]

  @@index([semesterId, importedAt])
  @@index([checksum])
}
